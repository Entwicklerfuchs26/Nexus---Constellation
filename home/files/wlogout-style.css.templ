* {
  font-family: "JetBrains Mono", monospace;
  border: none;
  outline: none;
}

window {
  background: rgba({{colors.surface.default.red}}, {{colors.surface.default.green}}, {{colors.surface.default.blue}}, 0.55);
}

box {
  background: transparent;
}

button {
  background: rgba({{colors.surface_container.default.red}}, {{colors.surface_container.default.green}}, {{colors.surface_container.default.blue}}, 0.9);
  color: {{colors.on_surface.default.hex}};
  border: 1px solid rgba({{colors.outline.default.red}}, {{colors.outline.default.green}}, {{colors.outline.default.blue}}, 0.3);
  border-radius: 28px;
  margin: 40px 16px;
  padding: 0px;
  min-width: 110px;
  min-height: 110px;
  transition: background 0.2s ease-in-out, border-color 0.2s ease-in-out;
}

button:hover, button:focus {
  background: rgba({{colors.primary.default.red}}, {{colors.primary.default.green}}, {{colors.primary.default.blue}}, 0.95);
  border-color: rgba({{colors.primary.default.red}}, {{colors.primary.default.green}}, {{colors.primary.default.blue}}, 1);
}

#lock, #logout, #suspend, #reboot, #shutdown, #hibernate {
  background-repeat: no-repeat;
  background-position: center;
  background-size: 44px 44px;
}

#lock { background-image: url("/home/fuchs/.config/wlogout/icons/lock.png"); }
#logout { background-image: url("/home/fuchs/.config/wlogout/icons/logout.png"); }
#suspend { background-image: url("/home/fuchs/.config/wlogout/icons/suspend.png"); }
#reboot { background-image: url("/home/fuchs/.config/wlogout/icons/reboot.png"); }
#shutdown { background-image: url("/home/fuchs/.config/wlogout/icons/shutdown.png"); }
#hibernate { background-image: url("/home/fuchs/.config/wlogout/icons/hibernate.png"); }
